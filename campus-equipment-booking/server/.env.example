# PostgreSQL / Supabase connection
# For Supabase, fill in your project connection string from Settings > Database.
# Example: postgresql://postgres:YOUR_PASSWORD@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Fallback local Postgres settings (used only when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=courtside
PGUSER=courtside_user
PGPASSWORD=your_database_password

# App
PORT=4000
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_ORIGIN=http://localhost:5173

# SMTP email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-sender@gmail.com
CLIENT_URL=http://localhost:5173

# Fine amounts (in your local currency's smallest sensible unit, e.g. rupees)
FINE_LATE_PER_DAY=50
FINE_DAMAGE=200
FINE_LOST=500

# Booking limits
MAX_ACTIVE_BOOKINGS_PER_STUDENT=3
